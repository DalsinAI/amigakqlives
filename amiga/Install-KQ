; $VER: Install-KQ 0.99.3-gfos1 (16.11.2026)
; The Amiga Installer script for KQ, an AmiCradle game port.
; Made by amicradle scripts/ports/port_installer.py: change the spec, not this file.
; Run it from its icon, beside the KQ drawer where the archive was unpacked.

(set @app-name "KQ")
(set #version "0.99.3-gfos1")
(set #drawer "KQ")
(set #program "KQ")
(set #space 2930)  ; KB

(onerror
    (message (cat "KQ was not installed completely." "\n\n" @error-msg
                  "\n\nFiles already copied stay where they are. Run Install-KQ again to finish.")))

; the Installer, the CPU and the FPU
(if (< @installer-version 2818051)
    (abort "KQ needs Installer 43.3 or newer. This one is older: install AmigaOS 3.2 or a newer Installer."))
(set #cpu (database "cpu"))
(if (not (or (= #cpu "68040") (= #cpu "68060") (= #cpu "68080")))
    (abort (cat "KQ needs a 68040, 68060 or 68080. This Amiga has a " #cpu ".")))

; the package: the drawer beside this script
(set #source (pathonly (expandpath @icon)))
(set #from (tackon #source #drawer))
(if (<> (exists #from (noreq)) 2)
    (abort "The KQ drawer is not beside Install-KQ. Unpack the whole archive, then run Install-KQ from there."))
(if (<> (exists (tackon #from #program) (noreq)) 1)
    (abort "The KQ drawer has no KQ in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/acgame.library") (noreq)) 1)
    (abort "The KQ drawer has no Libs/acgame.library in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/allegro4.library") (noreq)) 1)
    (abort "The KQ drawer has no Libs/allegro4.library in it. Unpack the whole archive again."))
(if (<> (exists (tackon #from "Libs/lua51.library") (noreq)) 1)
    (abort "The KQ drawer has no Libs/lua51.library in it. Unpack the whole archive again."))

(welcome "This installs KQ 0.99.3-gfos1 for AmigaOS 3.2 on a 68040, 68060 or 68080.")

; where: the parent drawer
(set #default
    (if (= (exists "Work:Games" (noreq)) 2) "Work:Games"
        (if (= (exists "Work:" (noreq)) 2) "Work:" "SYS:")))
(set #parent
    (askdir
        (prompt "Where should the KQ drawer go? Choose the drawer to put it in.")
        (help "The Installer makes or updates a drawer called KQ in the drawer you choose. An update keeps your saves and settings.")
        (default #default)))
(set #dest (tackon #parent #drawer))
(set #update (= (exists #dest (noreq)) 2))
; in KB where the Installer can say so: in bytes, 2 GB free and more does not fit
(set #free (if (>= @installer-version 2883584) (getdiskspace #parent "K")
    (/ (getdiskspace #parent) 1024)))
(if (and (>= #free 0) (< #free #space))
    (abort (cat "There is not enough room in " #parent ": KQ needs 3 MB free.")))

; shared libraries: into LIBS:, where the one there is older or missing
(copylib
    (prompt "Copying acgame.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/acgame.library"))
    (dest "LIBS:"))
(copylib
    (prompt "Copying allegro4.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/allegro4.library"))
    (dest "LIBS:"))
(copylib
    (prompt "Copying lua51.library to LIBS:")
    (help @copylib-help)
    (source (tackon #from "Libs/lua51.library"))
    (dest "LIBS:"))
(complete 40)

; the drawer: everything in it, but what the player has made
(set #kept "")
(if (exists (tackon #dest "User") (noreq))
    (set #kept (if (= #kept "") "User" (cat #kept "|" "User"))))
(if (not #update)
    (makedir #dest))
(if (= #kept "")
    (copyfiles
        (prompt "Copying KQ")
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (all)
        (optional "force" "askuser"))
    (copyfiles
        (prompt (cat "Updating KQ. Kept as they are: " #kept))
        (help @copyfiles-help)
        (source #from)
        (dest #dest)
        (pattern (cat "~(" #kept ")"))
        (optional "force" "askuser")))
(if (<> (exists (tackon #parent "KQ.info") (noreq)) 1)
    (copyfiles
        (help @copyfiles-help)
        (source #source)
        (dest #parent)
        (choices "KQ.info")))

(set #later "")
(set @default-dest #dest)
(complete 100)
(if @pretend
    (message (cat "Pretend: nothing was copied or changed. KQ would have gone in " #dest "."))
    (message (cat "KQ 0.99.3-gfos1 is installed in " #dest "."
                  "\n\nTo start it, open the KQ drawer and double-click the KQ icon."
                  (if (= #kept "") "" (cat "\n\nLeft as they were: " #kept "."))
                  (if (= #later "") "" (cat "\n\nStill to add to the drawer: " #later ". Run Install-KQ again to fetch or copy it.")))))
(exit (quiet))
